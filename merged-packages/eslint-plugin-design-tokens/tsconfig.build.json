{
  "extends": "../../tsconfig.packages.build.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "./src",
    // Keep the incremental build state inside the gitignored "dist" directory
    // so that deleting "dist" also discards the state and the next build
    // re-emits. The plugin's "build:types" script invokes "tsc" directly
    // (unlike other packages, which use `ts-bridge`), and plain `tsc -p`
    // skips emit when it considers the project up-to-date.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "references": [],
  "include": ["./src"]
}
