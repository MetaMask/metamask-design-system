{
  "name": "@metamask/probe-rb26b",
  "version": "0.0.0",
  "description": "Probe",
  "keywords": [
    "MetaMask",
    "Ethereum"
  ],
  "homepage": "https://github.com/MetaMask/metamask-design-system/tree/main/packages/probe-rb26b#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/metamask-design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/metamask-design-system.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "ts-bridge --project tsconfig.build.json --verbose --clean --no-references",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/probe-rb26b",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/probe-rb26b",
    "publish:preview": "yarn npm publish --tag preview",
    "test": "jest --reporters=jest-silent-reporter",
    "test:clean": "jest --clearCache",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^5.0.2",
    "@ts-bridge/cli": "^0.6.3",
    "@types/jest": "^27.4.1",
    "deepmerge": "^4.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scriptsConfig": {
    "#default": "lavamoat/scripts.base.json",
    "build": "lavamoat/scripts.build.json",
    "changelog:update": "lavamoat/scripts.lint.json",
    "changelog:validate": "lavamoat/scripts.lint.json",
    "publish:preview": "lavamoat/scripts.net.json",
    "test": "lavamoat/scripts.test.json",
    "test:clean": "lavamoat/scripts.test.json",
    "test:verbose": "lavamoat/scripts.test.json",
    "test:watch": "lavamoat/scripts.test.json"
  }
}
