{
  "name": "@metamask/design-system-shared",
  "version": "0.40.0",
  "description": "Shared types for design system libraries",
  "keywords": [
    "MetaMask",
    "Ethereum"
  ],
  "homepage": "https://github.com/MetaMask/metamask-design-system/tree/main/packages/design-system-shared#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/metamask-design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/metamask-design-system.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsx scripts/generate-icons.ts && tsc --project tsconfig.build.json",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/design-system-shared",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/design-system-shared",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --reporters=jest-silent-reporter",
    "test:clean": "NODE_OPTIONS=--experimental-vm-modules jest --clearCache",
    "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "publish:preview": "yarn npm publish --tag preview"
  },
  "dependencies": {
    "@metamask/utils": "^11.12.1"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/jest": "^27.4.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.2.0",
    "deepmerge": "^4.2.2",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "typescript": "~5.2.2"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
