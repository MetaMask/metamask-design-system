{
  "name": "@metamask/design-system-shared",
  "version": "0.45.1",
  "description": "Shared types for design system libraries",
  "keywords": [
    "MetaMask",
    "Ethereum"
  ],
  "homepage": "https://github.com/MetaMask/metamask-design-system/tree/main/packages/design-system-shared#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/metamask-design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/metamask-design-system.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node --import tsx scripts/generate-icons.ts && ts-bridge --project tsconfig.build.json --verbose --clean --no-references",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/design-system-shared",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/design-system-shared",
    "test": "jest --reporters=jest-silent-reporter",
    "test:clean": "jest --clearCache",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "generate-icons": "node --import tsx scripts/generate-icons.ts",
    "publish:preview": "yarn npm publish --tag preview"
  },
  "dependencies": {
    "@metamask/utils": "^11.12.1"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^7.1.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@ts-bridge/cli": "^0.6.3",
    "@types/jest": "^27.4.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.2.0",
    "deepmerge": "^4.2.2",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scriptsConfig": {
    "#default": "lavamoat/scripts.strict.json",
    "build": "lavamoat/scripts.cli.json",
    "changelog:update": "lavamoat/scripts.lint.json",
    "changelog:validate": "lavamoat/scripts.lint.json",
    "publish:preview": "lavamoat/scripts.net.json",
    "test": "lavamoat/scripts.test.json",
    "test:clean": "lavamoat/scripts.test.json",
    "test:verbose": "lavamoat/scripts.test.json",
    "test:watch": "lavamoat/scripts.test.json",
    "generate-icons": "lavamoat/scripts.cli.json"
  }
}
