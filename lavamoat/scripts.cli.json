{
  "notes": "For tsx-based code generators that read dependencies and write generated files inside the project.",
  "extends": "./scripts.base.json",
  "nodeOptions": {
    "--allow-fs-read": ["/"],
    "--allow-fs-write": ["$PROJECT_CWD"],
    "--allow-child-process": true,
    "--allow-net": false,
    "--allow-worker": true,
    "--allow-addons": false,
    "--allow-wasi": false,
    "--allow-inspector": false
  }
}
