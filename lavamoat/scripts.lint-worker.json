{
  "notes": "Same as scripts.lint.json, plus worker threads: eslint-plugin-prettier runs Prettier synchronously through a synckit worker.",
  "extends": "./scripts.base.json",
  "nodeOptions": {
    "--allow-fs-read": ["/"],
    "--allow-fs-write": ["$PROJECT_CWD"],
    "--allow-child-process": true,
    "--allow-net": false,
    "--allow-worker": true,
    "--allow-addons": true,
    "--allow-wasi": false,
    "--allow-inspector": false
  }
}
